require 'rake'
require 'fileutils'
require 'shellwords'
require 'tmpdir'
require 'open3'
require 'socket'

GRADLE = "./gradlew"

# Same convention as wavelen-market-data's rakefile: with no PROFILE env and
# not running the ci task, default to this machine's own short hostname
# rather than a generic "dev" - each dev box gets its own biblioteca/<host>
# pass-store section (e.g. biblioteca/zmeu) instead of everyone sharing one
# "dev" bucket. Explicit `rake run[dev]` (or any [task_profile] arg) still
# always wins - this is only the fallback.
profile = ENV['PROFILE'] || (Rake.application.top_level_tasks.include?('ci') ? 'ci' : Socket.gethostname.split('.').first)
puts "profile: #{profile}"

def load_profile_env(task_profile)
  $biblioteca_loaded_profiles ||= {}
  return if $biblioteca_loaded_profiles[task_profile]

  loader = ENV.fetch('PASSWORD_STORE_DIR', File.expand_path('~/.password-store')) + '/load-env.sh'
  unless File.file?(loader)
    raise "Password-store environment loader not found: #{loader}"
  end
  output, status = Open3.capture2('bash', '-c', "source #{Shellwords.escape(loader)} #{Shellwords.escape(task_profile)} && env -0")
  raise "Could not load biblioteca/#{task_profile} from pass store" unless status.success?
  output.split("\0").each do |entry|
    key, value = entry.split('=', 2)
    # Pass-store path settings may use the conventional leading `~/` form.
    # Expand only a leading tilde; values such as passwords remain untouched.
    value = value.sub(/\A~(?=\/|\z)/, Dir.home) if value
    ENV[key] = value if key && value
  end
  $biblioteca_loaded_profiles[task_profile] = true
  puts "> Loaded biblioteca/#{task_profile} from #{loader}"
end

IMAGE_NAME    = "editii/biblioteca-server"

version = File.read("build.gradle")[/^\s*version\s*=\s*['"]([^'"]+)['"]/, 1]

desc "Print the project version from build.gradle"
task :version do
  puts version
end

GV0 = '/media/gv0'
REPO = "#{GV0}/repo"
puts "Profile: #{profile}, version: #{version}"

# The admin and textbase Ionic/Angular frontends used to be built here
# (npm install && ionic build) and packaged into this app's static
# resources/executable JAR. Both are now their own standalone sibling repos
# (textbase-admin-ui, textbase-ionic-ui), built and deployed independently -
# nothing in this repo's build touches node/npm/ionic anymore.

task :default => [:clean, :build, :publish, "docker:publish"]

desc "Run the complete CI pipeline: clean, test, build, build the Docker image, and publish it"
task :ci => [:clean] do
  Rake::Task[:'check-env'].invoke('ci')
  Rake::Task[:test].invoke
  Rake::Task[:itest].invoke
  Rake::Task[:build].invoke('ci')
  Rake::Task['docker:publish'].invoke
end

desc "Same pipeline as ci, plus a GraalVM native-image build, published with a -graalvm tag suffix"
task :'ci-graalvm' => [:clean] do
  Rake::Task[:'check-env'].invoke('ci')
  Rake::Task[:test].invoke
  Rake::Task[:itest].invoke
  Rake::Task[:build].invoke('ci')
  # The opt-in native step (build.gradle gates the AOT/native tasks behind
  # -Pgraalvm). Expect the first stable builds to surface reachability-
  # metadata needs - Milvus SDK's gRPC/Netty stack is the likely first,
  # per build.gradle's own comment - this pipeline exists precisely to
  # measure that.
  sh "#{GRADLE} -Pprofile=ci -Pgraalvm nativeCompile"
  # Pick the native runtime stage from the same Dockerfile and publish
  # with the suffix: editii/biblioteca-server:<version>-graalvm.
  ENV['DOCKER_TAG_SUFFIX'] = '-graalvm'
  ENV['DOCKER_TARGET'] = 'runtime-native'
  Rake::Task['docker:publish'].invoke
end

desc "Run integration-test tagged tests against the integration dependencies"
task :itest, [:task_profile, :test_filter] do |_task, args|
  task_profile = args[:task_profile] || profile
  test_filter = args[:test_filter]
  load_profile_env(task_profile)
  puts "Running integration tests..."
  selector = ''
  if test_filter && !test_filter.empty?
    # Same friendly, case-insensitive filename filter as rake test - e.g.
    # `rake itest[dev,SearchITest]` runs only the matching test classes.
    needle = test_filter.downcase
    matches = Dir.glob('src/test/**/*.{groovy,java}').select do |path|
      File.basename(path, '.*').downcase.include?(needle)
    end
    selectors = matches.map do |path|
      source = File.read(path)
      package = source[/^\s*package\s+([\w.]+)/, 1]
      klass = File.basename(path, '.*')
      package ? "#{package}.#{klass}" : klass
    end.uniq
    abort "No test matches '#{test_filter}'" if selectors.empty?
    selector = selectors.map { |name| " --tests '#{name}'" }.join
  end
  sh "#{GRADLE} -Pprofile=#{task_profile} integrationTest#{selector}"
end

desc "Verify required environment variables are available from the pass store"
task :'check-env', [:task_profile] do |_task, args|
  task_profile = args[:task_profile] || 'dev'
  load_profile_env(task_profile)

  required = {
    # VECTORSTORE_URL is the canonical name of the active store's address
    # (qdrant by default); MILVUS_URL stays as an accepted alternative so
    # pass-store entries not yet renamed keep working.
    'dev' => [
      %w[VECTORSTORE_URL MILVUS_URL],
      'EMBEDDER_URL', 'TEI_REPOS', 'KAFKA_BROKERS', 'MYSQL_URL', 'WORK_DIR',
      'BIBLIOTECA_EXTERNAL_URL'
    ],
    'ci' => [
      %w[VECTORSTORE_URL MILVUS_URL MILVUS_ADDRESS],
      %w[EMBEDDER_URL EMBEDDER_ADDRESS],
      %w[TEI_REPOS],
      %w[KAFKA_BROKERS KAFKA_SERVERS],
      %w[MYSQL_URL MYSQL_JDBC_URL]
    ],
    'prod' => [
      %w[VECTORSTORE_URL MILVUS_URL],
      'EMBEDDER_URL', 'TEI_REPOS', 'KAFKA_BROKERS', 'MYSQL_URL'
    ]
  }
  expected = required.fetch(task_profile) { raise "Unknown profile '#{task_profile}' (expected dev, ci, or prod)" }
  missing = expected.reject do |entry|
    keys = entry.is_a?(Array) ? entry : [entry]
    keys.any? { |key| ENV[key] && !ENV[key].strip.empty? }
  end
  unless missing.empty?
    labels = missing.map { |entry| entry.is_a?(Array) ? entry.join(' or ') : entry }
    raise "Missing required #{task_profile} environment value(s) from pass store: #{labels.join(', ')}"
  end
  stage_dir = File.join(ENV.fetch('PASSWORD_STORE_DIR', File.expand_path('~/.password-store')), 'biblioteca', task_profile)
  stored_keys = Dir.glob(File.join(stage_dir, '*')).select { |path| File.file?(path) }
                  .map { |path| File.basename(path).sub(/\.gpg\z/, '') }
  expected_keys = expected.flatten
  extras = stored_keys - expected_keys
  warn "> Warning: unused #{task_profile} pass-store value(s): #{extras.sort.join(', ')}" unless extras.empty?
  puts "> #{task_profile} environment is complete (#{expected.length} required value(s) present)"
end

# Injects biblioteca/ci/* from the local `pass` store as real process
# env vars, BEFORE gradle runs - build.gradle's own fallback logic
# already prefers System.getenv(key) over .env.ci, so this alone is enough
# to make CI secret-complete without TeamCity needing to know about any of
# them itself. Never overwrites a value already present in ENV (e.g. a
# human testing `rake ci` locally with their own override). Same split as
# the prod compose stack's load-env.sh: *.gpg entries are real secrets
# (via `pass show`), everything else alongside them is non-secret,
# environment-specific plaintext config - both load the same way.
#
# biblioteca/ci is shared across every app in the Biblioteca family
# (this repo, textbase-reader, biblioteca-nestjs) - one flat section,
# not a per-repo subtree (was biblioteca-server/ci until this was
# consolidated; see the pass store's own README.md).
desc "Load biblioteca/ci/* secrets and config from the local pass store into the environment"
task :load_pass_secrets do
  store_dir = ENV['PASSWORD_STORE_DIR'] || File.expand_path('~/.password-store')
  ci_dir = File.join(store_dir, 'biblioteca', 'ci')

  unless Dir.exist?(ci_dir)
    puts "> No pass store found at #{ci_dir} - relying entirely on .env.ci"
    next
  end

  loaded = 0
  Dir.glob(File.join(ci_dir, '*')).select { |f| File.file?(f) }.sort.each do |entry|
    is_secret = entry.end_with?('.gpg')
    key = File.basename(entry, is_secret ? '.gpg' : '')
    next unless ENV[key].nil? || ENV[key].empty?

    value = is_secret ? `pass show biblioteca/ci/#{key}`.chomp : File.read(entry).chomp
    if is_secret ? ($?.success? && !value.empty?) : !value.empty?
      ENV[key] = value
      loaded += 1
    else
      warn "> pass show biblioteca/ci/#{key} failed or returned nothing"
    end
  end
  puts "> Loaded #{loaded} secret(s)/config value(s) from pass (#{ci_dir})"
end

task :test, [:task_profile, :test_filter] do |_task, args|
    task_profile = args[:task_profile] || profile
    test_filter = args[:test_filter]
    load_profile_env(task_profile)
    puts "Running unit and integration tests..."
    selector = ''
    if test_filter && !test_filter.empty?
      # Resolve the friendly filter case-insensitively against test source
      # filenames, then pass Gradle the exact fully-qualified class names.
      needle = test_filter.downcase
      matches = Dir.glob('src/test/**/*.{groovy,java}').select do |path|
        File.basename(path, '.*').downcase.include?(needle)
      end
      selectors = matches.map do |path|
        source = File.read(path)
        package = source[/^\s*package\s+([\w.]+)/, 1]
        klass = File.basename(path, '.*')
        package ? "#{package}.#{klass}" : klass
      end.uniq
      abort "No test matches '#{test_filter}'" if selectors.empty?
      selector = selectors.map { |name| " --tests '#{name}'" }.join
    end
    sh "#{GRADLE} -Pprofile=#{task_profile} test#{selector}"
end

task :run, [:task_profile] do |_task, args|
    run_profile = args[:task_profile] || profile
    load_profile_env(run_profile)
    puts "Running application..."
    sh "#{GRADLE} -Pprofile=#{run_profile} bootRun"
end

task :build, [:task_profile] do |_task, args|
    task_profile = args[:task_profile] || profile
    puts "Building application..."
    # Tests have their own Rake stage. Excluding Gradle's test task keeps
    # `rake ci` from running the same suite once here and once in `test[ci]`.
    sh "#{GRADLE} -Pprofile=#{task_profile} build -x test"
end

desc "Optionally compile the GraalVM native image (opt-in; not part of test/build/ci)"
task :graalvm, [:task_profile] do |_task, args|
    task_profile = args[:task_profile] || profile
    load_profile_env(task_profile)
    sh "#{GRADLE} -P#{task_profile} -Pgraalvm nativeCompile"
end

task :clean do
    puts "Cleaning build artifacts..."
    sh "#{GRADLE} -P#{profile} clean"
end

desc "publish library"
task publish: :check_mount do
  sh "#{GRADLE} publish -P#{profile} -PrepoDir=#{REPO}"
end

desc "Verify Gluster mount before publishing"
task :check_mount do
  require 'shellwords'
  puts "Checking GlusterFS mount at #{GV0}..."
  assert_gluster_mounted!(GV0)
  puts "Mount verified successfully."
end



def assert_gluster_mounted!(path)
  is_mounted = system("mountpoint -q #{path.shellescape}") rescue false

  unless is_mounted
    is_mounted = File.read('/proc/mounts').lines.any? do |line|
      line.split[1] == File.expand_path(path)
    end rescue false
  end

  unless is_mounted
    raise "GlusterFS error: Target directory '#{path}' is not a valid mount point!"
  end
end

def docker_tag
    # Empty suffix for the ordinary ci pipeline; rake ci-graalvm sets
    # DOCKER_TAG_SUFFIX (-graalvm) and DOCKER_TARGET (runtime-native)
    # before invoking docker:publish, so the native variant is
    # unmistakable in the registry. Computed at task-run time on purpose:
    # a load-time constant would freeze the empty suffix before
    # ci-graalvm ever got to set it. Re-reads build.gradle (a def method
    # has no closure over the rakefile's top-level version local, unlike
    # the task blocks) - same parse the top of this file does.
    v = File.read('build.gradle')[/^\s*version\s*=\s*['"]([^'"]+)['"]/, 1]
    "#{v}#{ENV['DOCKER_TAG_SUFFIX'] || ''}"
end

namespace :docker do

    LOCAL_REGISTRY = "mini.local:5000"

    desc "Build, tag, and publish image to local registry"
    task :build do
        local_tag = "#{IMAGE_NAME}:#{docker_tag}"
        target_tag = "#{LOCAL_REGISTRY}/#{IMAGE_NAME}:#{docker_tag}"
        build_target = ENV['DOCKER_TARGET'] || 'runtime'

        puts "==> Building Docker image (#{local_tag}, target #{build_target})..."
        sh "docker build -f docker/dockerfile --target #{build_target} --build-arg APP_VERSION=#{version} -t #{local_tag} ."

        puts "==> Tagging image for local registry..."
        sh "docker tag #{local_tag} #{target_tag}"

    end

    desc "Build, tag, and publish image to local registry"
    task :publish => [:build] do
        target_tag = "#{LOCAL_REGISTRY}/#{IMAGE_NAME}:#{docker_tag}"
        puts "==> Pushing image to #{LOCAL_REGISTRY}..."
        sh "docker push #{target_tag}"

        puts "==> Successfully published #{target_tag}!"
    end
end
